{
  "layer": "top",
  "position": "top",
  "height": 34,
  "no-center": true,

  "include": [
    "~/.config/waybar/modules.json"
  ],

  "modules-left": [
    "group/left",
    "group/center"
  ],

  "group/left": {
    "orientation": "horizontal",
    "modules": [
      "custom/appmenu",
      "hyprland/workspaces",
      "wlr/taskbar"
    ]
  },

  "group/center": {
    "orientation": "horizontal",
    "modules": [
      "custom/player",
      "hyprland/window"
    ]
  },

  "modules-right": [
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "backlight",
    "pulseaudio",
    "custom/cliphist",
    "tray",
    "clock",
    "custom/power"
  ]
}
